<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- groupId must be the Anypoint organization (business group) ID to publish to Exchange. -->
	<groupId>c17ce335-be76-4fd0-87e2-130837d2c65a</groupId>
	<artifactId>mule4-circuit-breaker</artifactId>
	<version>1.1.0</version>
	<packaging>mule-extension</packaging>

	<name>Circuit Breaker Extension for Mule 4</name>
	<description>Circuit breaker plugin for Mule 4, written from scratch, with a sliding-window failure-rate trigger and a pluggable state store.</description>
	<url>https://github.com/brunosouzas/mule4-circuit-breaker</url>

	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:https://github.com/brunosouzas/mule4-circuit-breaker.git</connection>
		<developerConnection>scm:git:https://github.com/brunosouzas/mule4-circuit-breaker.git</developerConnection>
		<url>https://github.com/brunosouzas/mule4-circuit-breaker</url>
		<tag>v1.1.0</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>17</java.version>

		<mule.api.version>1.9.17</mule.api.version>
		<mule.extensions.api.version>1.9.18</mule.extensions.api.version>
		<mule.sdk.api.version>1.2.0</mule.sdk.api.version>
		<mule.extensions.maven.plugin.version>1.9.6</mule.extensions.maven.plugin.version>
		<exchange.mule.maven.plugin.version>0.1.8</exchange.mule.maven.plugin.version>
		<mule.module.extensions.spring.support.version>4.9.1</mule.module.extensions.spring.support.version>
		<mule.version>4.9.1</mule.version>
		<slf4j.version>2.0.9</slf4j.version>

		<munit.version>3.7.1</munit.version>
		<munit.extensions.maven.plugin.version>1.7.2</munit.extensions.maven.plugin.version>
		<munit.runtime.version>4.12.0</munit.runtime.version>
		<junit.jupiter.version>5.10.2</junit.jupiter.version>
		<mockito.version>5.11.0</mockito.version>

		<maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
		<maven.clean.plugin.version>3.4.0</maven.clean.plugin.version>
		<maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
		<maven.antrun.plugin.version>3.1.0</maven.antrun.plugin.version>
		<maven.release.plugin.version>3.3.1</maven.release.plugin.version>
		<jacoco.maven.plugin.version>0.8.12</jacoco.maven.plugin.version>
		<jacoco.coverage.minimum>0.80</jacoco.coverage.minimum>
	</properties>

	<repositories>
		<!-- exchange-mule-maven-plugin's exchange-pre-deploy/exchange-deploy only inject the runId it
		     needs into a <repositories> entry whose URL matches its own v3-without-organization regex
		     (/api/v3/maven$, confirmed by disassembling ExchangeUriChecker) - the distributionManagement
		     entry below (org-scoped, for uploads) doesn't count for this. Without this entry the plugin's
		     own preConditions/status-check downloads fall through to mulesoft-releases and 404. Same URL
		     mulesoft-orders-api uses. -->
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
			<layout>default</layout>
		</repository>
		<snapshotRepository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
			<layout>default</layout>
		</snapshotRepository>
	</distributionManagement>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</pluginRepository>
	</pluginRepositories>

	<dependencies>
		<dependency>
			<groupId>org.mule.runtime</groupId>
			<artifactId>mule-api</artifactId>
			<version>${mule.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.mule.runtime</groupId>
			<artifactId>mule-extensions-api</artifactId>
			<version>${mule.extensions.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.mule.sdk</groupId>
			<artifactId>mule-sdk-api</artifactId>
			<version>${mule.sdk.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- "provided": supplied by the runtime container at deployment, not bundled in the plugin jar -
		     same treatment as mule-api/mule-extensions-api/mule-sdk-api above. Needed at main scope (not
		     just test) for ErrorClassifier to read the ErrorType off the event a MessagingException/
		     EventProcessingException carries (org.mule.runtime.core.privileged.exception, the runtime's
		     supported extension point for this, not an internal package) - see ErrorClassifier's javadoc.
		     Also used, test-only, by BRU-54's ReplicaSharedStateTest to construct the real persistent
		     Object Store implementation directly, to prove the actual runtime mechanism rather than a
		     hand-rolled stand-in. -->
		<dependency>
			<groupId>org.mule.runtime</groupId>
			<artifactId>mule-core</artifactId>
			<version>${mule.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>${maven.clean.plugin.version}</version>
			</plugin>
			<plugin>
				<!-- Implements the Exchange Maven Facade v3 publish handshake for non-application assets
				     (connectors/libraries). mule-maven-plugin provides the same handshake, but only for
				     mule-application packaging (see mulesoft-orders-api), not mule-extension.

				     exchange-pre-deploy rewrites the project's distributionManagement repository URL in
				     place to inject a runId - it doesn't upload anything itself. The plain
				     maven-deploy-plugin default-deploy execution (bound to the deploy phase by
				     mule-extension's packaging, left enabled, NOT overridden here) then uploads the
				     actual .jar/.pom/-mule-plugin.jar to that now-runId-scoped URL. exchange-deploy
				     (deploy phase, declared after default-deploy so it runs after it - Maven runs a
				     phase's default-lifecycle-bound goals before explicitly-declared same-phase
				     executions) uploads the closing exchange-eof.json marker and polls Exchange's
				     status endpoint until it finishes ingesting the artifact.

				     exchange-pre-deploy is bound to verify, not validate or deploy:
				     - Binding it to deploy (same phase as default-deploy) is wrong: without the URL
				       already rewritten before default-deploy runs, the actual artifacts upload to the
				       plain (non-runId) URL, and exchange-deploy's eof/finalize call then 500s against
				       a runId session that has no content - confirmed by trying it.
				     - Binding it to validate makes it (a real, authenticated Exchange call) run on
				       ci.yml's plain `mvn package` PR/branch builds too, since validate precedes
				       package in the lifecycle - confirmed locally (accidentally) with a real 401-class
				       failure ("User is not authorized...") from a `mvn package` run.
				     - Binding it to verify has the same problem for a *different* build: this repo also
				       has .github/workflows/build.yml, a plain GitHub Actions workflow (separate from
				       the Azure DevOps pipeline) that runs `mvn -B verify` on push/PR to main - and
				       unlike the Azure pipeline's "Build and package" job, that runner has no Exchange
				       credentials configured at all. Confirmed by PR #10 (develop -> main) failing its
				       GitHub Actions "test" check with 401 Unauthorized; PRs against develop never ran
				       this workflow (it only triggers on main), which is why this didn't surface sooner.
				     - install sits after both package and verify, still before deploy: neither ci.yml's
				       `mvn package` nor build.yml's `mvn verify` ever reaches it, while `mvn deploy`
				       (publish-snapshot.yml, release.yml) always runs through it on the way to the
				       deploy phase, in time to rewrite the URL before default-deploy. -->
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>exchange-mule-maven-plugin</artifactId>
				<version>${exchange.mule.maven.plugin.version}</version>
				<executions>
					<execution>
						<id>exchange-pre-deploy</id>
						<phase>install</phase>
						<goals>
							<goal>exchange-pre-deploy</goal>
						</goals>
					</execution>
					<execution>
						<id>exchange-deploy</id>
						<phase>deploy</phase>
						<goals>
							<goal>exchange-deploy</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>${maven.release.plugin.version}</version>
				<configuration>
					<!-- [skip ci] stops the release commits from triggering the pipeline again. -->
					<scmCommentPrefix>[skip ci] [maven-release-plugin] </scmCommentPrefix>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<goals>deploy</goals>
					<pushChanges>true</pushChanges>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.plugin.version}</version>
				<configuration>
					<release>${java.version}</release>
					<parameters>true</parameters>
					<annotationProcessorPaths>
						<path>
							<groupId>org.mule.runtime</groupId>
							<artifactId>mule-module-extensions-spring-support</artifactId>
							<version>${mule.module.extensions.spring.support.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.mule.runtime.plugins</groupId>
				<artifactId>mule-extensions-maven-plugin</artifactId>
				<version>${mule.extensions.maven.plugin.version}</version>
				<extensions>true</extensions>
				<executions>
					<!-- Java SDK extension: no module-*.xml to auto-generate a descriptor from; the
					     hand-written mule-artifact.json (with its own extensionModelLoaderDescriptor)
					     is the source of truth, so this default goal is disabled. -->
					<execution>
						<id>default-extension-descriptor</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- extension-validate (bound after mule-extensions:package, same phase) reads
				     Target-Java-Release-Version from this generated manifest; without it the goal NPEs
				     on a null version string. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>${maven.antrun.plugin.version}</version>
				<executions>
					<execution>
						<id>write-mule-packager-java-release-manifest</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.directory}/mule-packager/src/main/resources/META-INF" />
								<echo file="${project.build.directory}/mule-packager/src/main/resources/META-INF/MANIFEST.MF" append="false">Manifest-Version: 1.0${line.separator}Target-Java-Release-Version: ${java.version}${line.separator}</echo>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${maven.resources.plugin.version}</version>
				<executions>
					<execution>
						<!-- munit-extensions-maven-plugin only looks for suites under
						     target/test-mule/munit; this stages them there from src/test/munit. -->
						<id>copy-munit-suites</id>
						<phase>process-test-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/test-mule/munit</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/src/test/munit</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.mulesoft.munit</groupId>
				<artifactId>munit-extensions-maven-plugin</artifactId>
				<version>${munit.extensions.maven.plugin.version}</version>
				<configuration>
					<!-- Forces the embedded test runtime to fork on the same JDK running Maven. Without
					     this, the plugin resolves the system's default `java` (via java_home), which on a
					     machine with multiple JDKs installed can be newer than what this Mule runtime
					     version's JavaVersion enum recognizes, crashing extension-model parsing. -->
					<jvm>${java.home}/bin/java</jvm>
					<runtimeVersion>${munit.runtime.version}</runtimeVersion>
				</configuration>
				<executions>
					<!-- The mule-extension packaging's own lifecycle mapping binds this goal under the id
					     "default-test" regardless of any custom execution declared here, so that exact id
					     must be overridden to actually disable it.

					     Disabled: the embedded test runtime dynamically builds the XML/DSL schema for
					     "java"-loader (Java SDK) extensions differently than for "xml-based" ones, and in
					     this toolchain that dynamic schema is never registered for a Java SDK scope
					     operation, so the suite fails to deploy regardless of the extension model being
					     otherwise valid (confirmed correct via the generated extension-model.json). This
					     matches this author's own established pattern elsewhere on this machine:
					     mulesoft-parquet-connector (Java SDK) ships no MUnit suite at all, while
					     mulesoft-health-check-connector (XML SDK) does. Run manually with
					     `mvn com.mulesoft.munit:munit-extensions-maven-plugin:test` once this
					     environment/tooling issue is resolved; the suite under src/test/munit is kept
					     ready for that. The JUnit suite is the enforced, CI-gating test evidence for now. -->
					<execution>
						<id>default-test</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.maven.plugin.version}</version>
				<configuration>
					<!-- Pure SDK declaration classes: no logic of their own to unit test, and validated
					     structurally by mule-extensions:extension-validate instead. -->
					<excludes>
						<exclude>**/CircuitBreakerExtension.class</exclude>
						<exclude>**/CircuitBreakerConfiguration.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.coverage.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
